# ============================================================
# Linsiq API — Production Dockerfile
# Multi-stage build for optimized production image
# Build context: repo root (so use backend/ prefix)
# ============================================================

# --- Stage 1: Builder ---
FROM python:3.11-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies into a virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# --- Stage 2: Production ---
FROM python:3.11-slim AS production

# Security: Create non-root user
RUN groupadd -r linsiq && useradd -r -g linsiq -s /bin/false linsiq

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY --chown=linsiq:linsiq backend/ .

# Switch to non-root user
USER linsiq

# Expose port
ENV PYTHONUNBUFFERED=1

# Use $PORT env var (Render sets this), fallback to 8000 for local
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 2
